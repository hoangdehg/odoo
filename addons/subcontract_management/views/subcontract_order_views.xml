<odoo>
    <record id="subcontract_order_action" model="ir.actions.act_window">
        <field name="name">Đơn chế tác</field>
        <field name="res_model">subcontract.order</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- TREE -->
    <record id="view_subcontract_order_tree" model="ir.ui.view">
        <field name="name">subcontract.order.tree</field>
        <field name="model">subcontract.order</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="order_date"/>
                <field name="amount_total"/>
            </tree>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_subcontract_order_form" model="ir.ui.view">
        <field name="name">subcontract.order.form</field>
        <field name="model">subcontract.order</field>
        <field name="arch" type="xml">
            <form modifiers='{"readonly": [["state","=","done"]]}'>
                <header>
                        <field name="state" widget="statusbar"/>
                </header>
                <sheet>

                    <!-- 2 CỘT CHÍNH -->
                    <group col="2">

                        <!-- CỘT TRÁI -->
                        <group colspan="1" col="1">

                            <group string="Thông tin khách hàng">
                                <field name="partner_id"/>
                                <field name="partner_phone" readonly="1"/>
                                <field name="partner_address" readonly="1"/>
                            </group>

                            <group string="Thông tin người nhận">
                                <field name="receiver_is_customer"
                                    modifiers='{"readonly": [["state","!=","waiting_return"]]}'/>

                                <field name="receiver_name"
                                    modifiers='{
                                        "readonly": [
                                        "|",
                                        ["receiver_is_customer","=",true],
                                        ["state","!=","waiting_return"]
                                        ]
                                    }'/>

                                <field name="receiver_phone"
                                    modifiers='{
                                        "readonly": [
                                        "|",
                                        ["receiver_is_customer","=",true],
                                        ["state","!=","waiting_return"]
                                        ]
                                    }'/>

                                <field name="receiver_address"
                                    modifiers='{
                                        "readonly": [
                                        "|",
                                        ["receiver_is_customer","=",true],
                                        ["state","!=","waiting_return"]
                                        ]
                                    }'/>
                            </group>

                        </group>

                        <!-- CỘT PHẢI -->
                        <group string="Thông tin đơn hàng">
                            <field name="name"/>
                            <field name="order_date"/>
                            <field name="expected_return_date"/>
                            <field name="state" readonly="1"/>
                        </group>

                    </group>

                    <!-- TAB SẢN PHẨM -->
                    <notebook>
                        <page string="Sản phẩm">
                            <field name="line_ids"
                                options='{"no_create": true, "no_create_edit": true}'
                                modifiers='{"readonly": [["state","not in",["draft","waiting_deposit"]]]}'>
                                <tree>
                                    <field name="product_id"
                                        options='{"no_create": true, "no_create_edit": true}'/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                    <!-- FOOTER -->
                    <group col="2" class="oe_subtotal_footer oe_right">
                        <field name="amount_total" readonly="1"/>
                        <field name="deposit_amount"/>
                        <field name="amount_remaining" readonly="1"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_subcontract_order_search" model="ir.ui.view">
        <field name="name">subcontract.order.search</field>
        <field name="model">subcontract.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <separator/>
            </search>
        </field>
    </record>
</odoo>
