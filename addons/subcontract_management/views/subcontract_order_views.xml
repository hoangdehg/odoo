<odoo>
    <record id="subcontract_order_action" model="ir.actions.act_window">
        <field name="name">Subcontract Orders</field>
        <field name="res_model">subcontract.order</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- TREE -->
    <record id="view_subcontract_order_tree" model="ir.ui.view">
        <field name="name">subcontract.order.tree</field>
        <field name="model">subcontract.order</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_order"/>
                <field name="state"/>
                <field name="amount_total"/>
            </tree>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_subcontract_order_form" model="ir.ui.view">
        <field name="name">subcontract.order.form</field>
        <field name="model">subcontract.order</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="user_id"/>
                        <field name="state"/>
                    </group>

                    <notebook>
                        <page string="Chi tiết">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="service_product_id"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                    <group>
                        <field name="amount_total" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_subcontract_order_search" model="ir.ui.view">
        <field name="name">subcontract.order.search</field>
        <field name="model">subcontract.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <separator/>
            </search>
        </field>
    </record>
</odoo>
